# Required. Keep this secret; never prefix it with NEXT_PUBLIC_.
BUSINESSKORO_API_KEY=your_business_koro_api_key

# Must match the exact domain to which Business Koro locked your key.
# Example for the current production site:
STOREFRONT_DOMAIN=ajziostore.vercel.app

# Optional: price shown to customers = Business Koro suggestedPrice * multiplier.
# Keep 1 unless you deliberately want to adjust your selling prices.
AJZIO_PRICE_MULTIPLIER=1

# Optional public store content (not secrets).
STORE_ANNOUNCEMENT=
STORE_HERO_LINE_1=Quality you can
STORE_HERO_ACCENT=feel
STORE_HERO_LINE_2=every day
STORE_HERO_TEXT=Carefully chosen products, delivered to your door. Welcome to AJZIO Store.
STORE_PHONE=
STORE_WHATSAPP=
STORE_EMAIL=
STORE_ADDRESS=
